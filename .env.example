# Example Environment Configuration
# Copy this file to .env and fill in your actual database credentials

# Database connection string
# Format: mysql://username:password@host:port/database_name
DATABASE_URL=mysql://username:password@localhost:3306/database_name

# Logging level (debug, info, warn, error)
RUST_LOG=info

# Optional purger settings (can also be set via command line)
# RETENTION_DAYS=90          # How many days of data to keep
# BATCH_SIZE=500             # Number of rows to delete per batch
# SLEEP_MS=200               # Milliseconds to sleep between batches
# MAX_CONNECTIONS=30         # Max DB connections before throttling
# METRICS_PORT=9090          # Port for Prometheus metrics